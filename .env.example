# 豆包语音 TTS（火山引擎 openspeech，v3 流式接口）
# 申请地址：https://console.volcengine.com/speech
# 鉴权二选一：DOUBAO_TTS_API_KEY（新版 API Key），或 DOUBAO_APP_ID + DOUBAO_ACCESS_KEY（控制台配套）
#DOUBAO_TTS_API_KEY=your_api_key_here
#DOUBAO_APP_ID=your_app_id_here
#DOUBAO_ACCESS_KEY=your_access_token_here
DOUBAO_TTS_VOICE_ID=your_voice_id_here
# 可选：默认按音色自动推断（S_ 克隆音色 → seed-icl-2.0，uranus → seed-tts-2.0，其他官方音色 → seed-tts-1.0）
#DOUBAO_TTS_RESOURCE_ID=
# 可选：默认 https://openspeech.bytedance.com/api/v3/tts/unidirectional
#DOUBAO_TTS_ENDPOINT=

# AI看片评审（可选云能力，scripts/cloud/ai-review-video.py）
# 火山方舟 API Key，申请地址：https://console.volcengine.com/ark
ARK_API_KEY=your_ark_api_key_here
